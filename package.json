{
  "name": "primer-compiler",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Primer Compiler \u2014 hackathon scaffold. Compiles an official curriculum snapshot into an evidence-gated course and item bank, or refuses.",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "snapshot": "tsx script/snapshot.ts",
    "demo-fixtures": "tsx script/demoFixtures.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "reliability": "tsx script/reliability.ts",
    "verify": "npm run check && npm run test && npm run build",
    "build:vercel": "npx vite build && tsx script/vercelApi.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.5",
    "clsx": "^2.1.1",
    "express": "^5.0.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "vitest": "^2.1.9"
  }
}
