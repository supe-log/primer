# Primer Compiler — local environment template.
# Copy to .env. Never commit a real key. No secrets belong in this repo.

# xAI API key for grok-4.6. Engineer 1 wires this into server/compiler/model/xaiModelClient.ts.
# Until it is set, the compiler runs on MockModelClient and the frozen fixtures.
# On Vercel: set this in the project dashboard (Production + Preview). Never commit the value.
XAI_API_KEY=

# Optional. Defaults to 5000. Ignored on Vercel.
PORT=5000

# Optional. Defaults to 127.0.0.1 for local listen. Ignored on Vercel.
HOST=
